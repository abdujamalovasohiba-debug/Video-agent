      "Psixologik yordam –",
      "faqat oilani saqlab qolish emas"
    ],
    [
      1,
      9,
      15,
      "Psixologik maqsad:",
      "shu odam kuyib, nobud bo'lib ketmasin"
    ],
    [
      1,
      16,
      20,
      "Nevroz bo'lsa –",
      "nevrozdan qutulish kerak"
    ],
    [
      1,
      21,
      29,

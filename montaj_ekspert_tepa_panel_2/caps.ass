Dialogue: 0,0:00:00.00,0:00:01.54,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Bir xil joyda bo'ladiki,
Dialogue: 0,0:00:01.65,0:00:04.00,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}ularga oila haqida maslahat beramiz,
Dialogue: 0,0:00:04.00,0:00:06.55,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}lekin o'zlari psixologik suhbat orasida
Dialogue: 0,0:00:06.55,0:00:08.70,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}tushunyaptiki, bir-birini qiynab,
Dialogue: 0,0:00:08.70,0:00:11.12,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}bir-birini bo'g'ayotgan ekan hayotda.
Dialogue: 0,0:00:11.27,0:00:12.95,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}O'zi qaror qilib, o'zi ajrashib,
Dialogue: 0,0:00:12.95,0:00:14.89,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}baxtli bo'lib ketganlar ham kam emas.
Dialogue: 0,0:00:15.04,0:00:17.30,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Hattoki shu ajrashishda ham
Dialogue: 0,0:00:17.30,0:00:20.22,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}xatosini tushunib, xatosini anglab,
Dialogue: 0,0:00:20.32,0:00:21.89,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}bir-biri bilan do'stona
Dialogue: 0,0:00:21.89,0:00:22.98,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}ajrashish kerak.
Dialogue: 0,0:00:23.03,0:00:25.89,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Nimaga desa, agar do'stona ajrashmasa,
Dialogue: 0,0:00:25.89,0:00:27.39,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}nafrat bilan bo'lsa,
Dialogue: 0,0:00:27.39,0:00:30.10,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}ikkalasi ham bolasiga nafrat beradi.
Dialogue: 0,0:00:30.19,0:00:31.42,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Bola go'yo ota-onasi
Dialogue: 0,0:00:31.42,0:00:32.91,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}o'lib qolgandek bo'ladi.
Dialogue: 0,0:00:32.91,0:00:34.82,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Holbuki ota-ona ketib qolmaydi,
Dialogue: 0,0:00:34.82,0:00:35.56,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}ota-ona bor.
Dialogue: 0,0:00:35.67,0:00:37.92,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Bola ham bor, otasi ham, onasi ham
Dialogue: 0,0:00:37.92,0:00:38.72,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}mehr beradi,
Dialogue: 0,0:00:38.72,0:00:40.57,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}faqat har xil joydan beradi.
Dialogue: 0,0:00:40.57,0:00:43.29,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Bo'lmasa bir-biri bilan chiqisha olmaydi.
Dialogue: 0,0:00:43.34,0:00:45.00,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Bolani o'rtaga qo'yib,
Dialogue: 0,0:00:45.00,0:00:46.90,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}bahona qilish kerak emas.
Dialogue: 0,0:00:47.01,0:00:48.81,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}Chunki baxtli oila degani —
Dialogue: 0,0:00:48.81,0:00:50.80,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}albatta, qayerda muhabbat bor,
Dialogue: 0,0:00:50.80,0:00:52.54,Cap,,0,0,0,,{\pos(540,960)\fad(60,40)}o'sha oilada baxt bo'ladi.
